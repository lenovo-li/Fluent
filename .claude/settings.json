{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/check_all.py)",
      "Bash(python scripts/check_all.py *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 *)",
      "PowerShell(./scripts/build.ps1 *)",
      "Bash(./x64/Debug/FluentUITests.exe)",
      "Bash(./x64/Debug/FluentUITests.exe *)",
      "Bash(./x64/Release/FluentUITests.exe)",
      "Bash(./x64/Release/FluentUITests.exe *)",
      "Bash(./x64/Debug/FluentUIBench.exe)",
      "Bash(./x64/Debug/FluentUIBench.exe *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python scripts/check_docs_coverage.py)",
      "Bash(python scripts/check_docs_coverage.py *)"
    ],
    "deny": [
      "Read(project_bundle.md)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -rf *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(Remove-Item * -Recurse *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-doc-exists.py"],
            "timeout": 10,
            "statusMessage": "doc existence check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-project-files.py"],
            "timeout": 30,
            "statusMessage": "check_all.py (project files)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.py"],
            "timeout": 60,
            "statusMessage": "completion gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "fluent-reviewer|fluent-doc-auditor",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/record-review.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-instructions-loaded.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-resume.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
