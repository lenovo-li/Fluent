{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/check_all.py)",
      "Bash(python scripts/check_all.py *)",
      "Bash(\"C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe\" Fluent.slnx *)",
      "Bash(./x64/Debug/FluentUITests.exe)",
      "Bash(./x64/Debug/FluentUITests.exe *)",
      "Bash(./x64/Release/FluentUITests.exe)",
      "Bash(./x64/Release/FluentUITests.exe *)",
      "Bash(./x64/Debug/FluentUIBench.exe)",
      "Bash(./x64/Debug/FluentUIBench.exe *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-project-files.py"],
            "timeout": 30,
            "statusMessage": "check_all.py (project files)"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-instructions-loaded.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-resume.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
